[Unit]
Description=Airline Operations Center
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=airline
Group=airline
WorkingDirectory=/opt/airline-operations-center/app/current
EnvironmentFile=/opt/airline-operations-center/shared/.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/airline-operations-center /var/log/airline-operations-center
StandardOutput=append:/var/log/airline-operations-center/app.log
StandardError=append:/var/log/airline-operations-center/error.log

[Install]
WantedBy=multi-user.target
