[Unit]
Description=Airline Operations encrypted database backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
WorkingDirectory=/opt/airline-operations-center/app/current
ExecStart=/usr/bin/node scripts/create-encrypted-backup.mjs create
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/airline-operations-center/backups/managed-encrypted-v1
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=1G
StandardOutput=journal
StandardError=journal
