NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_VERSION=1.0.0
COOKIE_SECURE=true

DATABASE_URL=postgresql://airline:CHANGE_ME@127.0.0.1:5432/airline_operations
PGSSLMODE=disable

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
COS_BACKUP_URI=

# Only required when starting with an empty production database.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_NAME=系统管理员
ADMIN_BOOTSTRAP_PASSWORD=

# Optional when the frontend is served from a different origin.
# CORS_ORIGIN=https://www.ceairm.com
