NODE_ENV=production
HOST=127.0.0.1
PORT=8787
APP_VERSION=1.0.0
COOKIE_SECURE=true
APP_ORIGIN=https://www.ceairm.com
REQUEST_LOGS=1
TRUST_LOCAL_PROXY=true

DATABASE_URL=postgresql://airline:CHANGE_ME@127.0.0.1:5432/airline_operations
PGSSLMODE=disable
# 远程 PostgreSQL 改为 PGSSLMODE=verify-full，私有 CA 时填写证书绝对路径。
# PGSSLROOTCERT=/etc/ssl/certs/postgres-ca.pem

COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing
COS_BACKUP_URI=

# Only required when starting with an empty production database.
INITIAL_ADMIN_PASSWORD=
